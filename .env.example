# CoinBourg - AI-Powered Crypto Trading Bot
# Environment Configuration File
# ==============================
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=CoinBourg AI Trading Bot
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ===========================================
# DeepSeek AI Configuration
# ===========================================
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===========================================
# Binance API Configuration
# ===========================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For testnet keys: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# IMPORTANT: Set to true for testing, false for live trading
BINANCE_TESTNET=true

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://coinbourg:coinbourg_secure_password@db:5432/coinbourg
REDIS_URL=redis://redis:6379/0

# ===========================================
# Risk Management Settings
# ===========================================
# Options: CONSERVATIVE, MODERATE, AGGRESSIVE
RISK_LEVEL=CONSERVATIVE

# Maximum position size as percentage of portfolio
MAX_POSITION_SIZE_PERCENT=5.0

# Maximum trades per day
MAX_DAILY_TRADES=10

# Default stop loss percentage
STOP_LOSS_PERCENT=2.0

# Default take profit percentage
TAKE_PROFIT_PERCENT=4.0

# Maximum allowed portfolio drawdown percentage
MAX_DRAWDOWN_PERCENT=10.0

# ===========================================
# Trading Configuration
# ===========================================
# Comma-separated list of trading pairs
TRADING_PAIRS=["BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT", "XRPUSDT"]

# Base currency for trading
BASE_CURRENCY=USDT

# AI analysis interval in seconds (default: 5 minutes)
ANALYSIS_INTERVAL_SECONDS=300

# Price check interval in seconds (for SL/TP)
PRICE_CHECK_INTERVAL_SECONDS=10

# ===========================================
# Notification Settings (Optional)
# ===========================================
# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_NOTIFICATIONS=true

# ===========================================
# Web Dashboard / API Settings
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ===========================================
# Logging Settings
# ===========================================
LOG_LEVEL=INFO
